{
  "name": "pixel-forge-hosting",
  "version": "0.1.0",
  "description": "Pixel Forge Hosting - local-first Minecraft hosting for Windows",
  "main": "dist-electron/electron-main.js",
  "author": "Pixel Forge Hosting",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:electron": "electron .",
    "build:web": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build": "npm run build:web && npm run build:electron",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "dist": "npm run build && electron-builder --config electron-builder.yml",
    "dist:dir": "npm run build && electron-builder --config electron-builder.yml --dir",
    "electron": "electron ."
  },
  "dependencies": {
    "@vueuse/core": "^13.9.0",
    "pinia": "^3.0.3",
    "vue": "^3.5.18",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "electron": "^43.2.0",
    "electron-builder": "^26.0.12",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vue-tsc": "^3.0.6"
  }
}
